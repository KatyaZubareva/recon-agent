SOURCE_PORT=8093
POSTGRES_PORT=5543
# Real read-only HTTP/OData URL published by the candidate, without trailing slash:
ONEC_BASE_URL=http://localhost:8314/hs/recon
# Read-only пользователь 1С (роль ЧтениеДанных) — для приложения и агента.
ONEC_USER=reader
ONEC_PASSWORD=
# Администратор 1С (роль ПолныеПрава) — только для onec/restore.sh, агенту не передавать.
ONEC_ADMIN_USER=admin
ONEC_ADMIN_PASSWORD=
ONEC_PORT=8314
# Collection paths relative to ONEC_BASE_URL; candidate must match the real publication.
ONEC_ACCOUNTS_PATH=accounts
ONEC_CHARGES_PATH=charges
ONEC_PAYMENTS_PATH=payments
# Отчётная PostgreSQL (публичные локальные учебные учётные данные из compose.yaml).
# Importer — только для импорта/скриптов; агенту передаётся ТОЛЬКО RECON_READER_DSN.
RECON_IMPORTER_DSN=postgresql://importer:demo-importer-local@localhost:5543/reporting
RECON_READER_DSN=postgresql://agent_reader:demo-reader-local@localhost:5543/reporting
